rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 4.1: Global Safety Net — default deny everything unless explicitly allowed
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Phase 3: Global Primitives
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedOwner(userId) {
      return isEmailVerified() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Master Gate: Parent user profile must exist and belong to the caller
    function hasValidParentUser(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
        get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;
    }

    // =========================================================================
    // Shared Structural Validators (Matched Verbatim to firebase-blueprint.json
    // and budgeted well below Firestore's 1,000-expression evaluation limit)
    // =========================================================================
    function isValidStapleMeals(meals) {
      return meals is map &&
        meals.keys().hasAll(['breakfast', 'lunch', 'dinner', 'snack']) &&
        meals.keys().hasOnly(['breakfast', 'lunch', 'dinner', 'snack']) &&
        meals.breakfast is string && meals.breakfast.size() <= 300 &&
        meals.lunch is string && meals.lunch.size() <= 300 &&
        meals.dinner is string && meals.dinner.size() <= 300 &&
        meals.snack is string && meals.snack.size() <= 300;
    }

    function isValidDaySchedule(day) {
      return day is map &&
        day.keys().hasAll(['dayIndex', 'dayName', 'shortName', 'workoutTitle', 'exercises', 'durationMinutes', 'isRestDay']) &&
        day.keys().hasOnly(['dayIndex', 'dayName', 'shortName', 'workoutTitle', 'warmup', 'exercises', 'durationMinutes', 'isRestDay', 'mealOverrides']) &&
        day.dayIndex is number && day.dayIndex >= 0 && day.dayIndex <= 6 &&
        day.dayName is string && day.dayName.size() >= 1 && day.dayName.size() <= 30 &&
        day.shortName is string && day.shortName.size() >= 1 && day.shortName.size() <= 10 &&
        day.workoutTitle is string && day.workoutTitle.size() <= 140 &&
        (!('warmup' in day) || (day.warmup is string && day.warmup.size() <= 300)) &&
        day.exercises is string && day.exercises.size() <= 600 &&
        day.durationMinutes is number && day.durationMinutes >= 0 && day.durationMinutes <= 300 &&
        day.isRestDay is bool &&
        (!('mealOverrides' in day) || (
          day.mealOverrides is map &&
          day.mealOverrides.keys().hasOnly(['breakfast', 'lunch', 'dinner', 'snack'])
        ));
    }

    function isValidDaysArray(days) {
      return days is list &&
        days.size() == 7 &&
        isValidDaySchedule(days[0]) &&
        days[1] is map &&
        days[2] is map &&
        days[3] is map &&
        days[4] is map &&
        days[5] is map &&
        days[6] is map;
    }

    function isValidChecklistArray(checklist) {
      return checklist is list &&
        checklist.size() <= 100 &&
        (checklist.size() == 0 || (
          checklist[0] is map &&
          checklist[0].keys().hasAll(['id', 'category', 'text', 'checked']) &&
          checklist[0].keys().hasOnly(['id', 'category', 'text', 'checked']) &&
          checklist[0].id is string && checklist[0].id.size() >= 1 && checklist[0].id.size() <= 128 &&
          checklist[0].category in ['prep', 'grocery'] &&
          checklist[0].text is string && checklist[0].text.size() <= 240 &&
          checklist[0].checked is bool
        ));
    }

    function isValidWeeklyPlan(plan) {
      return plan is map &&
        plan.keys().hasAll([
          'version',
          'weekStartDate',
          'holidayTag',
          'caloriesTarget',
          'proteinTarget',
          'splitPreset',
          'prepTimeLimit',
          'stapleMeals',
          'days',
          'checklist'
        ]) &&
        plan.keys().hasOnly([
          'version',
          'weekStartDate',
          'holidayTag',
          'holidayNotes',
          'activeHolidayPlanId',
          'caloriesTarget',
          'proteinTarget',
          'splitPreset',
          'customSplitLabel',
          'prepTimeLimit',
          'stapleMeals',
          'days',
          'checklist',
          'dailyProgress'
        ]) &&
        plan.version is number && plan.version >= 1 && plan.version <= 100 &&
        plan.weekStartDate is string && plan.weekStartDate.size() == 10 &&
        plan.weekStartDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        plan.holidayTag is string && plan.holidayTag.size() >= 1 && plan.holidayTag.size() <= 100 &&
        (!('holidayNotes' in plan) || (plan.holidayNotes is string && plan.holidayNotes.size() <= 500)) &&
        (!('activeHolidayPlanId' in plan) || isValidId(plan.activeHolidayPlanId)) &&
        plan.caloriesTarget is number && plan.caloriesTarget >= 800 && plan.caloriesTarget <= 10000 &&
        plan.proteinTarget is number && plan.proteinTarget >= 20 && plan.proteinTarget <= 500 &&
        plan.splitPreset in ['ppl', 'upper-lower', 'full-body', 'holiday-maintenance'] &&
        (!('customSplitLabel' in plan) || (plan.customSplitLabel is string && plan.customSplitLabel.size() <= 80)) &&
        plan.prepTimeLimit in ['30 mins', '60 mins', '90+ mins'] &&
        isValidStapleMeals(plan.stapleMeals) &&
        isValidDaysArray(plan.days) &&
        isValidChecklistArray(plan.checklist) &&
        (!('dailyProgress' in plan) || (
          plan.dailyProgress is map &&
          plan.dailyProgress.size() <= 7 &&
          plan.dailyProgress.keys().hasOnly(['0', '1', '2', '3', '4', '5', '6'])
        ));
    }

    function isValidBmiState(bmi) {
      return bmi is map &&
        bmi.keys().hasAll(['unit', 'heightCm', 'weightKg', 'feet', 'inches', 'weightLbs', 'goal']) &&
        bmi.keys().hasOnly(['unit', 'heightCm', 'weightKg', 'feet', 'inches', 'weightLbs', 'goal']) &&
        bmi.unit in ['metric', 'imperial'] &&
        bmi.heightCm is string && bmi.heightCm.size() <= 12 &&
        bmi.weightKg is string && bmi.weightKg.size() <= 12 &&
        bmi.feet is string && bmi.feet.size() <= 12 &&
        bmi.inches is string && bmi.inches.size() <= 12 &&
        bmi.weightLbs is string && bmi.weightLbs.size() <= 12 &&
        bmi.goal in ['fat-loss', 'maintain', 'lean-bulk'];
    }

    function isValidBookmarkedTips(ids) {
      return ids is list &&
        ids.size() <= 50 &&
        (ids.size() == 0 || (ids[0] is string && ids[0].size() >= 1 && ids[0].size() <= 80));
    }

    function isValidSavedVideos(videos) {
      return videos is map && videos.size() <= 25;
    }

    // =========================================================================
    // Entity Validation Blueprints (Pillar 2: Anti-Update-Gap)
    // =========================================================================
    function isValidUserProfile(data, userId) {
      return data is map &&
        data.keys().hasAll(['ownerId', 'displayName', 'email', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'displayName', 'email', 'photoURL', 'createdAt', 'updatedAt']) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.ownerId == userId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserWorkspace(data, userId) {
      return data is map &&
        data.keys().hasAll([
          'ownerId',
          'activePlan',
          'bookmarkedTipIds',
          'bmiState',
          'savedVideos',
          'visualMode',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'activePlan',
          'normalWeekBackup',
          'bookmarkedTipIds',
          'bmiState',
          'savedVideos',
          'visualMode',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.ownerId == userId &&
        isValidWeeklyPlan(data.activePlan) &&
        (!('normalWeekBackup' in data) || data.normalWeekBackup == null || isValidWeeklyPlan(data.normalWeekBackup)) &&
        isValidBookmarkedTips(data.bookmarkedTipIds) &&
        isValidBmiState(data.bmiState) &&
        isValidSavedVideos(data.savedVideos) &&
        data.visualMode in ['infographic', 'illustration'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidHolidayPlan(data, userId, holidayPlanId) {
      return data is map &&
        data.keys().hasAll([
          'ownerId',
          'id',
          'name',
          'notes',
          'caloriesTarget',
          'proteinTarget',
          'prepTimeLimit',
          'splitPreset',
          'stapleMeals',
          'days',
          'checklist',
          'updatedAtIso',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'id',
          'name',
          'notes',
          'caloriesTarget',
          'proteinTarget',
          'prepTimeLimit',
          'splitPreset',
          'customSplitLabel',
          'stapleMeals',
          'days',
          'checklist',
          'updatedAtIso',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.ownerId == userId &&
        isValidId(data.id) &&
        data.id == holidayPlanId &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.notes is string && data.notes.size() <= 500 &&
        data.caloriesTarget is number && data.caloriesTarget >= 800 && data.caloriesTarget <= 10000 &&
        data.proteinTarget is number && data.proteinTarget >= 20 && data.proteinTarget <= 500 &&
        data.prepTimeLimit in ['30 mins', '60 mins', '90+ mins'] &&
        data.splitPreset in ['ppl', 'upper-lower', 'full-body', 'holiday-maintenance'] &&
        (!('customSplitLabel' in data) || (data.customSplitLabel is string && data.customSplitLabel.size() <= 80)) &&
        isValidStapleMeals(data.stapleMeals) &&
        isValidDaysArray(data.days) &&
        isValidChecklistArray(data.checklist) &&
        data.updatedAtIso is string && data.updatedAtIso.size() >= 1 && data.updatedAtIso.size() <= 64 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSavedPreset(data, userId, presetId) {
      return data is map &&
        data.keys().hasAll(['ownerId', 'id', 'name', 'savedAt', 'plan', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'id', 'name', 'savedAt', 'plan', 'createdAt', 'updatedAt']) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.ownerId == userId &&
        isValidId(data.id) &&
        data.id == presetId &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.savedAt is string && data.savedAt.size() >= 1 && data.savedAt.size() <= 64 &&
        isValidWeeklyPlan(data.plan) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // =========================================================================
    // Collection Rules
    // =========================================================================

    // 1. Private User Profile (Pillar 6: PII Isolation — strictly owner only, no list)
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isVerifiedOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action: Sync Google profile metadata
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'updatedAt'])
        );

      allow delete: if isVerifiedOwner(userId) && isValidId(userId);

      // 2. Primary Workspace Document (/users/{userId}/workspaces/{workspaceId})
      match /workspaces/{workspaceId} {
        allow get: if isOwner(userId) &&
          isValidId(userId) &&
          workspaceId == 'primary' &&
          hasValidParentUser(userId);
        allow list: if false;

        allow create: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          workspaceId == 'primary' &&
          isValidUserWorkspace(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          hasValidParentUser(userId);

        allow update: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          workspaceId == 'primary' &&
          isValidUserWorkspace(incoming(), userId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          hasValidParentUser(userId) &&
          (
            // Action: Sync active plan, optional normal-week backup, or user preferences
            incoming().diff(existing()).affectedKeys().hasOnly(['activePlan', 'normalWeekBackup', 'bookmarkedTipIds', 'bmiState', 'savedVideos', 'visualMode', 'updatedAt'])
          );

        allow delete: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          workspaceId == 'primary' &&
          hasValidParentUser(userId);
      }

      // 3. Custom Holiday Plans Subcollection (/users/{userId}/holidayPlans/{holidayPlanId})
      match /holidayPlans/{holidayPlanId} {
        allow get: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(holidayPlanId) &&
          hasValidParentUser(userId);

        // Pillar 8: Secure List Query without get()/exists() cost explosion
        allow list: if isOwner(userId) &&
          existing().ownerId == request.auth.uid;

        allow create: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(holidayPlanId) &&
          isValidHolidayPlan(incoming(), userId, holidayPlanId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          hasValidParentUser(userId);

        allow update: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(holidayPlanId) &&
          isValidHolidayPlan(incoming(), userId, holidayPlanId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().id == existing().id &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          hasValidParentUser(userId) &&
          (
            // Action: Edit holiday plan details
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'notes', 'caloriesTarget', 'proteinTarget', 'prepTimeLimit', 'updatedAtIso', 'updatedAt']) ||
            // Action: Sync full weekly schedule edits into holiday plan
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name',
              'notes',
              'caloriesTarget',
              'proteinTarget',
              'prepTimeLimit',
              'splitPreset',
              'customSplitLabel',
              'stapleMeals',
              'days',
              'checklist',
              'updatedAtIso',
              'updatedAt'
            ])
          );

        allow delete: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(holidayPlanId) &&
          hasValidParentUser(userId);
      }

      // 4. Saved Reusable Plan Presets Subcollection (/users/{userId}/savedPresets/{presetId})
      match /savedPresets/{presetId} {
        allow get: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(presetId) &&
          hasValidParentUser(userId);

        // Pillar 8: Secure List Query without get()/exists() cost explosion
        allow list: if isOwner(userId) &&
          existing().ownerId == request.auth.uid;

        allow create: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(presetId) &&
          isValidSavedPreset(incoming(), userId, presetId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          hasValidParentUser(userId);

        allow update: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(presetId) &&
          isValidSavedPreset(incoming(), userId, presetId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().id == existing().id &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          hasValidParentUser(userId) &&
          (
            // Action: Rename or refresh saved preset snapshot
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'savedAt', 'plan', 'updatedAt'])
          );

        allow delete: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(presetId) &&
          hasValidParentUser(userId);
      }
    }
  }
}
